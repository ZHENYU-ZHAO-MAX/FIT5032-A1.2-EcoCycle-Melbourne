# Copy to .env.local and fill in. Never commit real keys (.env.local is git-ignored).
# Firebase console -> Project settings -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Functions region (must match functions/index.js setGlobalOptions)
VITE_FUNCTIONS_REGION=australia-southeast1
# Mapbox public token (pk.*) - restrict it to your deployed URL in the Mapbox dashboard
VITE_MAPBOX_TOKEN=
# Set to true to talk to the local Firebase emulators during development
VITE_USE_EMULATORS=false