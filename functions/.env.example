# Non-secret function parameters. Copy to functions/.env (git-ignored) or answer the CLI prompts on deploy.
# A SendGrid *verified sender* address (Single Sender Verification or authenticated domain).
SENDGRID_FROM=eco@your-verified-domain.example
# Comma-separated emails that become admins automatically on first login (email must be verified).
ADMIN_EMAILS=you@example.com
# The SendGrid API key is a SECRET - set it with:  firebase functions:secrets:set SENDGRID_API_KEY
